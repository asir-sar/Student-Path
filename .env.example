# Copy to .env and fill in. Empty values count as "not set".
# Check what the app sees with: uv run sp config

# Gemini (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=
# Pin exact model ids (https://ai.google.dev/gemini-api/docs/models) so eval runs stay comparable
GEMINI_FAST_MODEL=
GEMINI_SMART_MODEL=

# Qdrant: embedded mode stores data in QDRANT_PATH; set QDRANT_URL (e.g. http://localhost:6333) to use a server
QDRANT_PATH=data/qdrant
QDRANT_URL=
QDRANT_COLLECTION=modules

# Embedding model
EMBEDDING_MODEL=BAAI/bge-m3

# Paths (relative to the project root)
PDF_PATH=data/source/Modulkatalog-Master-Informatik.pdf
DATA_DIR=data

# Langfuse tracing (phase P4); the Langfuse SDK reads these itself
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
